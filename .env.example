DATABASE_URL="postgresql://user:password@localhost:5432/cargo_kenya_dev?schema=public"
SOCKET_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Runtime mode is required; production startup rejects mock payments.
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
PAYMENT_MODE=mock
PAYMENT_PROVIDER_CURRENCY=KES

# Replace with a local-only random value when testing signed webhooks.
# Production requires at least 32 characters and the selected provider's
# actual signature protocol/header must be confirmed before go-live.
PAYMENT_WEBHOOK_SECRET=replace-with-a-local-only-random-webhook-secret

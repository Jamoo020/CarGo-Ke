# Map provider is "development" (free local coordinate plot) or "google".
# Vite development defaults to development; production defaults to Google Maps.
VITE_MAP_PROVIDER=development

# Only required when VITE_MAP_PROVIDER=google. Restrict this browser key by
# HTTP referrer and API before use; the free development provider never calls Google.
VITE_GOOGLE_MAPS_BROWSER_KEY=your-restricted-browser-key

# Optional; defaults to the local backend.
# VITE_API_BASE_URL=http://localhost:4000
# Production builds must set this to the HTTPS backend origin.

# Optional public business-enquiry address shown on /business and /contact.
# Configure only an approved mailbox; leave unset otherwise.
# VITE_PUBLIC_CONTACT_EMAIL=

# Optional backend-only route key belongs in the backend .env; never expose it here.
# GOOGLE_MAPS_API_KEY is not a VITE_ variable and must not be bundled for the browser.
